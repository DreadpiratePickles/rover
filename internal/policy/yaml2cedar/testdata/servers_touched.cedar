// Generated by `rover policy compile` from servers_touched.yaml.
// Do not edit: edit the YAML and compile again. Rover denies anything no permit allows.

@id("no-mail-after-hr")
// from servers_touched.yaml:6
forbid (
  principal,
  action == Action::"call_tool",
  resource == Tool::"mail/send"
)
when {
  context.session.servers_touched.contains("hr-db") &&
  context.session.servers_touched.contains("files")
};

@id("no-egress-after-private-hr")
// from servers_touched.yaml:9
forbid (
  principal,
  action == Action::"call_tool",
  resource
)
when {
  context.session.touched_private == true &&
  context.session.servers_touched.contains("hr-db") &&
  resource.labels.contains("egress")
};
