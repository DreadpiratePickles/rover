@id("gh-push-needs-approval")
// from require.yaml:6
@rover_require("approval")
permit (
  principal,
  action == Action::"call_tool",
  resource == Tool::"github/push_files"
);

@id("gh-pr-needs-approval")
// from require.yaml:9
@rover_require("approval")
permit (
  principal,
  action == Action::"call_tool",
  resource == Tool::"github/create_pull_request"
)
when {
  context.session.saw_untrusted == false
};

@id("github-list-tools")
// implied: allow rules for github need the agent to see the tool list
permit (principal, action == Action::"list_tools", resource == Server::"github");
