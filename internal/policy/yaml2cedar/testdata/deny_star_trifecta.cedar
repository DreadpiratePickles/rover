// Generated by `rover policy compile` from deny_star_trifecta.yaml.
// Do not edit: edit the YAML and compile again. Rover denies anything no permit allows.

@id("trifecta-no-egress")
// from deny_star_trifecta.yaml:13
forbid (
  principal,
  action == Action::"call_tool",
  resource
)
when {
  context.session.touched_private == true &&
  context.session.saw_untrusted == true &&
  resource.labels.contains("egress")
};

@id("no-destructive")
// from deny_star_trifecta.yaml:18
forbid (
  principal,
  action == Action::"call_tool",
  resource
)
when {
  resource.labels.contains("destructive")
};

@id("untrusted-session-quiet")
// from deny_star_trifecta.yaml:21
forbid (
  principal,
  action,
  resource
)
when {
  context.session.saw_untrusted == true
};
