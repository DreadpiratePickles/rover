// Generated by `rover policy compile` from hour_between.yaml.
// Do not edit: edit the YAML and compile again. Rover denies anything no permit allows.

@id("git-commit-office-hours")
// from hour_between.yaml:6
permit (
  principal,
  action == Action::"call_tool",
  resource == Tool::"git/git_commit"
)
when {
  context.time.hour >= 9 && context.time.hour < 18
};

@id("git-status-work")
// from hour_between.yaml:9
permit (
  principal,
  action == Action::"call_tool",
  resource == Tool::"git/git_status"
)
when {
  context.time.hour >= 8 && context.time.hour < 20 &&
  context.norm has path.under_work && context.norm.path.under_work == true
};

@id("nothing-before-six")
// from hour_between.yaml:12
forbid (
  principal,
  action,
  resource
)
when {
  context.time.hour >= 0 && context.time.hour < 6
};

@id("git-list-tools")
// implied: allow rules for git need the agent to see the tool list
permit (principal, action == Action::"list_tools", resource == Server::"git");
