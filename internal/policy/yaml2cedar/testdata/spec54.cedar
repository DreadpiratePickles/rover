@id("fs-read-projects")
// from spec54.yaml:8
permit (
  principal,
  action == Action::"call_tool",
  resource == Tool::"filesystem/read_file"
)
when {
  context.norm has path.under_projects && context.norm.path.under_projects == true
};

@id("gh-no-delete")
// from spec54.yaml:11
@rover_hide("true")
forbid (
  principal,
  action == Action::"call_tool",
  resource == Tool::"github/delete_repository"
);

@id("gh-push-needs-approval")
// from spec54.yaml:14
@rover_require("approval")
permit (
  principal,
  action == Action::"call_tool",
  resource == Tool::"github/push_files"
);

@id("trifecta")
// from spec54.yaml:17
forbid (
  principal,
  action == Action::"call_tool",
  resource
)
when {
  context.session.touched_private == true &&
  context.session.saw_untrusted == true &&
  resource.labels.contains("egress")
};

@id("filesystem-list-tools")
// implied: allow rules for filesystem need the agent to see the tool list
permit (principal, action == Action::"list_tools", resource == Server::"filesystem");

@id("github-list-tools")
// implied: allow rules for github need the agent to see the tool list
permit (principal, action == Action::"list_tools", resource == Server::"github");
