// Generated by `rover policy compile` from host_in.yaml.
// Do not edit: edit the YAML and compile again. Rover denies anything no permit allows.

@id("fetch-docs")
// from host_in.yaml:8
permit (
  principal,
  action == Action::"call_tool",
  resource == Tool::"fetch/fetch"
)
when {
  context.norm has url && ["docs.python.org", "pkg.go.dev", "developer.mozilla.org"].contains(context.norm.url.host)
};

@id("fetch-never-pastebin")
// from host_in.yaml:11
forbid (
  principal,
  action == Action::"call_tool",
  resource == Tool::"fetch/fetch"
)
when {
  context.norm has url && ["pastebin.com"].contains(context.norm.url.host)
};

@id("fetch-list-tools")
// implied: allow rules for fetch need the agent to see the tool list
permit (principal, action == Action::"list_tools", resource == Server::"fetch");
