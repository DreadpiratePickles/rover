// Rover gate Cedar schema (plan §5.1).
//
// Every policy is validated against this file in strict mode when it is
// loaded. A policy that names an unknown entity type, action, attribute or
// context key is rejected, so a typo cannot silently turn into "never
// matches" (which, for a forbid, would mean "never blocks").
//
// Adjustments to the §5.1 text, made so that cedar-go v1.8.0 x/exp/schema
// parses and resolves it, and so strict validation can type-check policies:
//  1. CallContext and BaseContext were comments in §5.1. They are real
//     `type` declarations here. Cedar types cannot extend each other, so
//     CallContext repeats the four BaseContext fields and adds args and norm.
//  2. "args: Record" and "norm: Record" are not valid Cedar: Cedar has no
//     open record type. Args and Norm below list the attributes a policy may
//     use. Every one of them is OPTIONAL ("?:"), because a call may leave an
//     argument out. Strict validation then insists on a `has` guard before
//     the attribute is read, for example
//         context.norm has path.under_projects && context.norm.path.under_projects
//     so a missing argument is a plain `false`, not an evaluation error.
//  3. The four declarations Args, Norm, NormPath and NormPaths are
//     GENERATED. roverd and `rover policy validate` call policy.SchemaFor,
//     which rewrites them from config: every root <r> in config.yaml (or
//     policy.yaml) becomes under_<r>?: Bool / all_under_<r>?: Bool, and
//     every argument named in the normalisers becomes a Norm attribute.
//     What you see here is the default for one root named "projects".
//     Print the schema actually in force with
//         rover policy validate --print-schema
//  4. Common types (Session, Device, ...) name the nested records.

entity Client   { name: String, version: String };               // e.g. "claude-code"
entity Server   { name: String, transport: String, pinned: Bool };
entity Tool in [Server] { name: String, labels: Set<String> };    // labels: reads_private | reads_untrusted | egress | destructive
entity Resource in [Server] { uri: String };

// context.session: what this agent has done across every server (M8).
//   touched_private  a reads_private tool call SUCCEEDED (its result arrived)
//   saw_untrusted    a reads_untrusted result arrived, or any result had a
//                    medium or high detection finding
//   calls            forwarded tools/call requests
//   servers_touched  names of the servers with at least one forwarded call
type Session   = { touched_private: Bool, saw_untrusted: Bool, calls: Long, servers_touched: Set<String> };
type Device    = { managed: Bool, healthy: Bool, quarantined: Bool, tags: Set<String> };
type Time      = { hour: Long, weekday: Long };                    // weekday 0 = Sunday
type Detection = { max_score: Long, findings: Set<String> };

// context.args: the converted tool arguments (§5.2). Raw text: prefer norm.
type Args = {
  branch?: String,
  owner?: String,
  path?: String,
  query?: String,
  repo?: String,
  url?: String
};

// context.norm: the normalised arguments (§5.3).
type NormPath = {
  path?: String,
  under_projects?: Bool
};
type NormPaths = {
  paths?: Set<String>,
  count?: Long,
  all_under_projects?: Bool
};
type NormURL   = { scheme: String, host: String, port: String, has_query: Bool };
type Norm = {
  destination?: NormPath,
  files?: NormPaths,
  path?: NormPath,
  paths?: NormPaths,
  repo_path?: NormPath,
  source?: NormPath,
  url?: NormURL
};

type BaseContext = { session: Session, device: Device, time: Time, detection: Detection };
type CallContext = {
  session: Session, device: Device, time: Time, detection: Detection,
  args: Args, norm: Norm
};

action "call_tool"          appliesTo { principal: Client, resource: Tool,     context: CallContext };
action "list_tools"         appliesTo { principal: Client, resource: Server,   context: BaseContext };
action "read_resource"      appliesTo { principal: Client, resource: Resource, context: BaseContext };
action "server_sampling"    appliesTo { principal: Client, resource: Server,   context: BaseContext }; // server->client sampling/createMessage
action "server_elicitation" appliesTo { principal: Client, resource: Server,   context: BaseContext }; // server->client elicitation/create
